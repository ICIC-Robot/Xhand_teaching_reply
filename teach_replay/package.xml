<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>teach_replay</name>
  <version>0.1.0</version>
  <description>Franka + XHand teach and replay: record a hand-guided demo to a bag, smooth and time-parameterize it offline (B-spline + toppra), replay it with trajectory_replay_controller and a 83 Hz hand timer.</description>
  <maintainer email="322911981+ICIC-Robot@users.noreply.github.com">ICIC-Robot</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>rosbag2_py</exec_depend>
  <exec_depend>ros2bag</exec_depend>
  <exec_depend>rosidl_runtime_py</exec_depend>
  <exec_depend>builtin_interfaces</exec_depend>
  <exec_depend>controller_manager_msgs</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>franka_msgs</exec_depend>
  <exec_depend>xhand_control_interfaces</exec_depend>
  <exec_depend>teach_replay_controllers</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
